# ============================================================
# Liz Coder Plus - Environment Variables
# Copy this file to .env and fill in your API keys.
# ============================================================

# --- Primary AI Provider (NVIDIA NIM - Free) ---
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE

# --- Optional AI Providers ---
# OpenAI
OPENAI_API_KEY=
LIZ_AI_BASE_URL=
# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Google (Gemini)
GOOGLE_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
# Mistral AI
MISTRAL_API_KEY=
# OpenRouter
OPENROUTER_API_KEY=

# --- NVIDIA NIM Auto-Detection ---
# If NVIDIA_API_KEY is set, the system automatically discovers
# and registers all available free models on startup.

# --- Ollama (Local) ---
LIZ_OLLAMA_ENABLE=false
OLLAMA_BASE_URL=http://localhost:11434/v1
LIZ_OLLAMA_MODELS=llama3:8b,qwen2.5:7b

# --- OpenRouter Custom Models ---
LIZ_OPENROUTER_MODELS=anthropic/claude-3.5-sonnet

# --- Fallback (if no ModelManager) ---
LIZ_AI_API_KEY=
LIZ_AI_MODEL=
