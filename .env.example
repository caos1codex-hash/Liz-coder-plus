# Liz Coder Plus - Environment Variables
# Copy this file to .env and fill in your API keys.

# ──────────────────────────────────────────────────────────────────────
# AI Provider API Keys (at least one required for LLM features)
# ──────────────────────────────────────────────────────────────────────

# OpenAI API Key (also supports compatible APIs like Azure, vLLM, Together)
OPENAI_API_KEY=sk-...

# Anthropic Claude API Key
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key
GOOGLE_API_KEY=...

# OpenRouter API Key (access to multiple providers)
OPENROUTER_API_KEY=sk-or-...

# ──────────────────────────────────────────────────────────────────────
# Liz AI Configuration
# ──────────────────────────────────────────────────────────────────────

# Default model (overrides config file)
LIZ_AI_MODEL=gpt-4o-mini

# Generic AI API key (used as fallback)
LIZ_AI_API_KEY=

# Custom AI API base URL (for self-hosted models)
LIZ_AI_BASE_URL=

# ──────────────────────────────────────────────────────────────────────
# Local Models (Ollama)
# ──────────────────────────────────────────────────────────────────────

# Enable Ollama integration (set to "true" or "1" to enable)
LIZ_OLLAMA_ENABLE=false

# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434/v1

# Comma-separated list of Ollama models to register
LIZ_OLLAMA_MODELS=llama3:8b,qwen2.5:7b

# ──────────────────────────────────────────────────────────────────────
# OpenRouter Models
# ──────────────────────────────────────────────────────────────────────

# Comma-separated list of OpenRouter model IDs
LIZ_OPENROUTER_MODELS=anthropic/claude-3.5-sonnet

# ──────────────────────────────────────────────────────────────────────
# Environment
# ──────────────────────────────────────────────────────────────────────

# LIZ_ENV=development  (development | production)
LIZ_ENV=development
