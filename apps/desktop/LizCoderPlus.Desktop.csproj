<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Liz Coder Plus - Desktop Application
    WinUI 3 / .NET 8 - MVVM Architecture
    Sprint 1 - Prompt 1 (Foundation)
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LizCoderPlus.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.17.0</Version>
    <ApplicationVersion>0.17.0</ApplicationVersion>
    <Company>Liz Coder Plus</Company>
    <Product>Liz Coder Plus Desktop</Product>
    <Description>Sistema Operativo de IA Personal - Asistente de Escritorio con Multi-Agentes</Description>
    <Copyright>2024 Liz Coder Plus - MIT License</Copyright>
    <AssemblyTitle>LizCoderPlus.Desktop</AssemblyTitle>
    <AssemblyProduct>Liz Coder Plus</AssemblyProduct>

    <!-- Publish settings -->
    <PlatformTarget>x64</PlatformTarget>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <AppxPackage>false</AppxPackage>

    <!-- Skip PRI generation (avoids MSB4062 on CI runners without VS extensions) -->
    <GeneratePriFileOnBuild>false</GeneratePriFileOnBuild>

    <!-- App icon metadata -->
    <ApplicationIcon></ApplicationIcon>
    <PackageId>LizCoderPlus.Desktop</PackageId>
  </PropertyGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240227000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>

</Project>
