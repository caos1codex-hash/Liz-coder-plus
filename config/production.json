{
  "version": "0.13.0",
  "environment": "production",
  "ai": {
    "provider": "nvidia",
    "model": "meta/llama-3.1-405b-instruct",
    "temperature": 0.5,
    "max_tokens": 8192,
    "api_key_env": "NVIDIA_API_KEY",
    "models": {
      "default": "meta/llama-3.1-405b-instruct",
      "coding": "deepseek-coder",
      "research": "meta/llama-3.1-405b-instruct",
      "fast": "google/gemma-2-9b-it",
      "reasoning": "deepseek-reasoner"
    },
    "nvidia": {
      "base_url": "https://integrate.api.nvidia.com/v1",
      "api_key_env": "NVIDIA_API_KEY",
      "priority_models": [
        "meta/llama-3.1-405b-instruct",
        "meta/llama-3.1-70b-instruct",
        "mistralai/mistral-large-2-instruct",
        "qwen/qwen2.5-72b-instruct"
      ]
    },
    "deepseek": {
      "base_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "mistral": {
      "base_url": "https://api.mistral.ai/v1",
      "api_key_env": "MISTRAL_API_KEY"
    }
  },
  "permissions": {
    "mode": "confirmation",
    "allowed_commands": [
      "git status",
      "git log"
    ],
    "denied_commands": [
      "rm -rf",
      "format",
      "del /f /s /q",
      "shutdown",
      "taskkill /f",
      "reg delete",
      "reg add"
    ]
  },
  "logging": {
    "level": "INFO",
    "to_file": true,
    "file_path": "logs/production.log"
  },
  "backend": {
    "host": "0.0.0.0",
    "port": 8000,
    "reload": false,
    "cors_origins": [
      "https://lizcoderplus.local"
    ]
  },
  "memory": {
    "enabled": true,
    "provider": "sqlite",
    "path": "data/liz_memory.db",
    "max_history": 200
  }
}
