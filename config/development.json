{
  "version": "1.1.0",
  "environment": "development",
  "ai": {
    "provider": "nvidia",
    "model": "meta/llama-3.1-405b-instruct",
    "temperature": 0.7,
    "max_tokens": 4096,
    "api_key_env": "NVIDIA_API_KEY",
    "models": {
      "default": "meta/llama-3.1-405b-instruct",
      "coding": "deepseek-coder",
      "research": "meta/llama-3.1-405b-instruct",
      "fast": "google/gemma-2-9b-it",
      "reasoning": "deepseek-reasoner",
      "local": "llama3:8b"
    },
    "nvidia": {
      "base_url": "https://integrate.api.nvidia.com/v1",
      "api_key_env": "NVIDIA_API_KEY",
      "priority_models": [
        "meta/llama-3.1-405b-instruct",
        "meta/llama-3.1-70b-instruct",
        "mistralai/mistral-large-2-instruct",
        "qwen/qwen2.5-72b-instruct"
      ]
    },
    "deepseek": {
      "base_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "mistral": {
      "base_url": "https://api.mistral.ai/v1",
      "api_key_env": "MISTRAL_API_KEY"
    }
  },
  "permissions": {
    "mode": "confirmation",
    "allowed_commands": [
      "git status",
      "git log",
      "git diff",
      "git branch",
      "git show",
      "dir",
      "ls",
      "cat",
      "echo",
      "pwd",
      "whoami",
      "date",
      "python --version",
      "pip list",
      "npm list",
      "node --version",
      "git add",
      "git commit",
      "git push",
      "git pull"
    ],
    "denied_commands": [
      "rm -rf",
      "format",
      "del /f /s /q",
      "shutdown",
      "taskkill /f",
      "mkfs",
      "dd if=",
      ":(){ :|:& };:"
    ]
  },
  "logging": {
    "level": "DEBUG",
    "to_file": true,
    "file_path": "logs/development.log"
  },
  "backend": {
    "host": "127.0.0.1",
    "port": 8000,
    "reload": true,
    "cors_origins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ]
  },
  "memory": {
    "enabled": true,
    "provider": "sqlite",
    "path": "data/liz_memory.db",
    "max_history": 200
  }
}
