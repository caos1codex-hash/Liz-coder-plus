{
  "version": "1.0.0",
  "environment": "development",
  "ai": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "temperature": 0.7,
    "max_tokens": 4096,
    "api_key_env": "LIZ_AI_API_KEY",
    "models": {
      "default": "gpt-4o-mini",
      "coding": "gpt-4o",
      "research": "claude-sonnet-4-20250514",
      "fast": "gpt-4o-mini",
      "local": "llama3:8b"
    }
  },
  "permissions": {
    "mode": "confirmation",
    "allowed_commands": [
      "git status",
      "git log",
      "git diff",
      "git branch",
      "git show",
      "dir",
      "ls",
      "cat",
      "echo",
      "pwd",
      "whoami",
      "date",
      "python --version",
      "pip list",
      "npm list",
      "node --version"
    ],
    "denied_commands": [
      "rm -rf",
      "format",
      "del /f /s /q",
      "shutdown",
      "taskkill /f",
      "mkfs",
      "dd if=",
      ":(){ :|:& };:"
    ]
  },
  "logging": {
    "level": "DEBUG",
    "to_file": true,
    "file_path": "logs/development.log"
  },
  "backend": {
    "host": "127.0.0.1",
    "port": 8000,
    "reload": true,
    "cors_origins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ]
  },
  "memory": {
    "enabled": true,
    "provider": "sqlite",
    "path": "data/liz_memory.db",
    "max_history": 200
  }
}
